# SIH26139 Environment Configuration Example
# Copy this file to .env for local development. Never commit real credentials.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
RANDOM_SEED=42

# Database Configuration
DATABASE_URL=sqlite:///./sukshmadrishti.db

# JWT Authentication Configuration
JWT_SECRET_KEY=sukshmadrishti-dev-jwt-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Quantum Provider Configuration (Optional for hardware deployment)
# QISKIT_IBM_TOKEN=your_ibm_quantum_api_token_here
# QISKIT_BACKEND=ibmq_qasm_simulator

# Database / Supabase Configuration (Optional for cloud logging)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here

